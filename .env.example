# ==============================================================================
# SuperApp Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env or set these variables in your target environment.
# 2. DO NOT commit .env with real secrets to Git (.env is in .gitignore).
# 3. Default 'Mock' and 'Local' providers allow the application to run immediately
#    in development without external accounts or credentials.
# ==============================================================================

# --- Application Environment ---
ASPNETCORE_ENVIRONMENT=Development
PORT=5000

# --- Database ---
DATABASE_PROVIDER=SqlServer
# For local development: Server=localhost;Database=SuperAppDB;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=true;
# For Docker Compose: Server=superapp-db,1433;Database=SuperAppDB;User Id=sa;Password=<YOUR_STRONG_PASSWORD>;TrustServerCertificate=true;MultipleActiveResultSets=true;Encrypt=True
DATABASE_CONNECTION_STRING=

# --- JWT Authentication ---
# Minimum 32-64 character random cryptographically secure string
JWT_SECRET=
JWT_ISSUER=SuperApp
JWT_AUDIENCE=SuperApp
JWT_EXPIRY_DAYS=30

# --- SMS / OTP Provider ---
# Options: Mock, Karix, Twilio, Gupshup
OTP_PROVIDER=Mock
OTP_API_URL=
OTP_API_KEY=
OTP_API_SECRET=
OTP_SENDER_ID=
OTP_DLT_ENTITY_ID=
OTP_DLT_TEMPLATE_ID=

# --- Map & Geolocation Provider ---
# Options: Mock, Google, Mapbox
MAP_PROVIDER=Mock
MAP_API_KEY=
MAP_ANDROID_API_KEY=
MAP_IOS_API_KEY=
MAP_WEB_API_KEY=

# --- Payment Gateway Provider ---
# Options: Mock, Razorpay, Cashfree
PAYMENT_PROVIDER=Mock
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MERCHANT_ID=
PAYMENT_ENVIRONMENT=sandbox

# --- Storage Provider ---
# Options: Local, Azure, S3
STORAGE_PROVIDER=Local
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER_NAME=superapp-assets
STORAGE_BASE_URL=

# --- Push Notifications & Firebase ---
# Options: Mock, Firebase
NOTIFICATION_PROVIDER=Mock
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVER_KEY=

# --- Email Provider (Optional) ---
EMAIL_PROVIDER=None
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@superapp.internal
FROM_NAME=SuperApp

# --- WhatsApp Provider (Optional) ---
WHATSAPP_PROVIDER=None
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Distributed Cache / Messaging (Optional / Staging / Production) ---
REDIS_CONNECTION_STRING=
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=

# --- Production Host Domains ---
DOMAIN_API=api.superapp.com
DOMAIN_ADMIN=admin.superapp.com
DOMAIN_VENDOR=vendor.superapp.com
